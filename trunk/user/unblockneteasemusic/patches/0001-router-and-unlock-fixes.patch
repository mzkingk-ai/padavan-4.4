+	searchSong := common.SearchSong{
+		Keyword:     "晴天 周杰伦",
+		Name:        "晴天",
+		ArtistsName: "周杰伦",
+		ArtistList:  []string{"周杰伦"},
+		Quality:     common.ExHigh,
+		OrderBy:     common.PlatformDefault,
+	}
+	songs := (&KuWo{}).SearchSong(searchSong)
+	if len(songs) == 0 {
