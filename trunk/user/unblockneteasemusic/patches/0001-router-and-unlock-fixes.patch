+{'AARTIST':'','ALBUM':'','ARTIST':'周杰伦','COPYRIGHT':'0','DC_TARGETID':'474678847','FORMATS':'AAC48|MP3128','MINFO':'level:p,bitrate:192,format:ogg,size:4.32Mb','MUSICRID':'MUSIC_474678847','SONGNAME':'花海&nbsp;(DJ&nbsp;阿若版)'},
