+package kuwo
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/cnsilvan/UnblockNeteaseMusic/common"
+)
+
+// 这段 abslist 是 2026-10-31 从 search.kuwo.cn 实际抓下来的
+// 「晴天 周杰伦」结果，7 条里没有正版原唱，最能代表真实困境。
+const sampleAbsList = `[
+ {"MUSICRID":"MUSIC_51685512","SONGNAME":"晴天 (KTV版伴奏)","ARTIST":"周杰伦","ALBUM":""},
+ {"MUSICRID":"MUSIC_152809941","SONGNAME":"志明与春娇+听妈妈的话+干杯+晴天+离开地球表面+双截棍 (2013小巨蛋演唱会第三场)","ARTIST":"周杰伦&五月天","ALBUM":""},
+ {"MUSICRID":"MUSIC_190706031","SONGNAME":"新歌前奏 + Julia + 晴天 (片段)","ARTIST":"周杰伦&인피니트","ALBUM":""},
+ {"MUSICRID":"MUSIC_474678847","SONGNAME":"花海 (DJ 阿若版)","ARTIST":"周杰伦","ALBUM":""},
+ {"MUSICRID":"MUSIC_349354644","SONGNAME":"听妈妈的话 (完整版|DJ彭鹏版)","ARTIST":"周杰伦","ALBUM":""},
+ {"MUSICRID":"MUSIC_367887397","SONGNAME":"蜗牛","ARTIST":"周杰伦","ALBUM":""},
+ {"MUSICRID":"MUSIC_380476932","SONGNAME":"晴天 (原唱:周杰伦) 激情吃力版","ARTIST":"冬菇滑稽","ALBUM":""}
+]`
+
+func startSampleServer(t *testing.T) string {
+	t.Helper()
+	var list []interface{}
+	if err := json.Unmarshal([]byte(sampleAbsList), &list); err != nil {
+		t.Fatal(err)
+	}
+	content := []interface{}{
+		map[string]interface{}{"interestpage": map[string]interface{}{}},
+		map[string]interface{}{"musicpage": map[string]interface{}{"abslist": list}},
+	}
+	body, _ := json.Marshal(map[string]interface{}{"content": content})
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		w.Write(body)
+	}))
+	t.Cleanup(srv.Close)
+	return srv.URL + "/r.s?all=%s"
+}
+
+// 修复前：songs[0]（KTV 版伴奏）被无条件采纳，用户听到的是伴奏。
+// 修复后：解析真实搜索结果，所有候选都过不了阈值，结果必须是空——宁可无歌。
+func TestParseSongRejectsAllFromRealSample(t *testing.T) {
+	tmpl := startSampleServer(t)
+	old := SearchSongURL
+	SearchSongURL = tmpl
+	defer func() { SearchSongURL = old }()
+
+	searchSong := common.SearchSong{
+		Keyword:     "晴天 周杰伦",
+		Name:        "晴天",
+		ArtistsName: "周杰伦",
+		ArtistList:  []string{"周杰伦"},
+		Quality:     common.ExHigh,
+		OrderBy:     common.MatchedScoreDesc,
+	}
+
+	songs := (&KuWo{}).SearchSong(searchSong)
+	for _, s := range songs {
+		t.Logf("scored: %.2f %q - %q", s.MatchScore, s.Artist, s.Name)
+	}
+	if len(songs) != 0 {
+		t.Fatalf("样本里没有原唱，应当全部拒绝，却得到 %d 条，首条是 %q - %q (%.2f)",
+			len(songs), songs[0].Artist, songs[0].Name, songs[0].MatchScore)
+	}
+}
+
+// 阈值关闭时应恢复上游行为：连 KTV 版伴奏都会入选（上游就是这样把伴奏当原唱返回的）
+func TestParseSongFilterIsThresholdDriven(t *testing.T) {
+	tmpl := startSampleServer(t)
+	oldURL := SearchSongURL
+	oldScore := common.MinMatchScore
+	SearchSongURL = tmpl
+	common.MinMatchScore = 0
+	defer func() {
+		SearchSongURL = oldURL
+		common.MinMatchScore = oldScore
+	}()
+
+	searchSong := common.SearchSong{
+		Keyword:     "晴天 周杰伦",
+		Name:        "晴天",
+		ArtistsName: "周杰伦",
+		ArtistList:  []string{"周杰伦"},
+		Quality:     common.ExHigh,
+		OrderBy:     common.PlatformDefault,
+	}
+	songs := (&KuWo{}).SearchSong(searchSong)
+	if len(songs) == 0 {
+		t.Fatal("阈值关闭时应当仍能列出候选")
+	}
+	for _, s := range songs {
+		t.Logf("threshold off -> %q - %q %.2f", s.Artist, s.Name, s.MatchScore)
+	}
+}
